{
  "name": "dsh-qundao-doc",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Cheng Yin",
    "url": "https://github.com/Yang-unplugged"
  },
  "homepage": "https://github.com/Yang-unplugged/dsh-qundao-doc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yang-unplugged/dsh-qundao-doc.git"
  },
  "bugs": {
    "url": "https://github.com/Yang-unplugged/dsh-qundao-doc/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "documents",
    "editor",
    "rich-text",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "server",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "description": "按飞书文档交互复刻的本地富文本编辑器；数据只存在本机。"
}